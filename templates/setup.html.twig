<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QUINOS - Setup</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-700">
    <div class="max-w-5xl mx-auto px-5 py-10">
        <div class="flex items-center justify-between mb-7">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-sky-600 rounded-xl flex items-center justify-center text-white text-lg font-bold">Q</div>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800">System setup</h1>
                    <p class="text-sm text-slate-500">Database sources and SFTP delivery</p>
                </div>
            </div>
            {% if not first_run %}
            <a href="{{ base_path }}/home" class="text-sm font-medium text-sky-700 hover:text-sky-800">Back to dashboard</a>
            {% endif %}
        </div>

        {% if first_run %}
        <div class="mb-5 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-800">
            Complete the initial configuration. You will be sent to sign in after it is saved.
        </div>
        {% endif %}
        {% if error %}
        <div class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{{ error }}</div>
        {% endif %}
        {% if success %}
        <div class="mb-5 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">{{ success }}</div>
        {% endif %}

        <form method="POST" action="{{ base_path }}/setup" class="space-y-6">
            <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                <h2 class="font-semibold text-slate-800 mb-1">MySQL connection</h2>
                <p class="text-sm text-slate-400 mb-5">One server and login are shared by the default and category databases.</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <label class="block md:col-span-2">
                        <span class="block text-sm font-medium mb-1.5">Host</span>
                        <input name="db_host" required value="{{ form.db_host }}" class="field" placeholder="127.0.0.1">
                    </label>
                    <label class="block">
                        <span class="block text-sm font-medium mb-1.5">Port</span>
                        <input name="db_port" required inputmode="numeric" value="{{ form.db_port }}" class="field" placeholder="3306">
                    </label>
                    <label class="block">
                        <span class="block text-sm font-medium mb-1.5">Default database</span>
                        <input id="default-database" name="db_database" required value="{{ form.db_database }}" class="field" placeholder="db_parklife">
                    </label>
                    <label class="block">
                        <span class="block text-sm font-medium mb-1.5">Username</span>
                        <input name="db_username" required value="{{ form.db_username }}" class="field" autocomplete="username">
                    </label>
                    <label class="block">
                        <span class="block text-sm font-medium mb-1.5">Password</span>
                        <input type="password" name="db_password" value="" class="field" autocomplete="new-password" placeholder="{% if first_run %}May be empty{% else %}Leave blank to keep current password{% endif %}">
                    </label>
                </div>
            </section>

            <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                <h2 class="font-semibold text-slate-800 mb-1">Category source databases</h2>
                <p class="text-sm text-slate-400 mb-5">Leave a field empty to use the default database.</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
                    {% for c in categories %}
                    <label class="block">
                        <span class="flex items-center justify-between text-sm font-medium mb-1.5">
                            <span>{{ loop.index }}. {{ c.label }}</span>
                            <span class="text-[10px] uppercase tracking-wide text-slate-400">{{ c.type == 'sales' ? 'Sales' : 'No sales' }}</span>
                        </span>
                        <input name="category_db[{{ c.key }}]" value="{{ form.category_db[c.key] ?? '' }}" class="field category-db" placeholder="Use default database">
                    </label>
                    {% endfor %}
                </div>
            </section>

            <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                <div class="flex items-start justify-between gap-4 mb-5">
                    <div>
                        <h2 class="font-semibold text-slate-800 mb-1">SFTP delivery</h2>
                        <p class="text-sm text-slate-400">Credentials are required only when uploads are enabled.</p>
                    </div>
                    <label class="inline-flex items-center gap-2 text-sm font-medium cursor-pointer">
                        <input id="upload-enabled" type="checkbox" name="upload_enabled" value="1" {% if form.upload_enabled %}checked{% endif %} class="w-4 h-4 accent-sky-600">
                        Enable uploads
                    </label>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <label class="block md:col-span-2">
                        <span class="block text-sm font-medium mb-1.5">Host</span>
                        <input name="sftp_host" value="{{ form.sftp_host }}" class="field sftp-field" placeholder="example.com">
                    </label>
                    <label class="block">
                        <span class="block text-sm font-medium mb-1.5">Port</span>
                        <input name="sftp_port" inputmode="numeric" value="{{ form.sftp_port }}" class="field sftp-field" placeholder="22">
                    </label>
                    <label class="block">
                        <span class="block text-sm font-medium mb-1.5">Remote root directory</span>
                        <input name="sftp_remote_dir" value="{{ form.sftp_remote_dir }}" class="field sftp-field" placeholder="uploads">
                    </label>
                    <label class="block">
                        <span class="block text-sm font-medium mb-1.5">Username</span>
                        <input name="sftp_user" value="{{ form.sftp_user }}" class="field sftp-field" autocomplete="username">
                    </label>
                    <label class="block">
                        <span class="block text-sm font-medium mb-1.5">Password</span>
                        <input type="password" name="sftp_password" value="" class="field sftp-field" autocomplete="new-password" placeholder="{% if first_run %}SFTP password{% else %}Leave blank to keep current password{% endif %}">
                    </label>
                </div>
            </section>

            <div class="flex justify-end">
                <button type="submit" class="px-6 py-2.5 rounded-full bg-sky-600 hover:bg-sky-700 text-white text-sm font-semibold shadow-sm transition">
                    Validate and save
                </button>
            </div>
        </form>
    </div>

    <style>
        .field { width: 100%; border: 1px solid #e2e8f0; border-radius: .75rem; background: #f8fafc; padding: .65rem .85rem; font-size: .875rem; outline: none; transition: .15s; }
        .field:focus { border-color: #38bdf8; background: white; box-shadow: 0 0 0 3px rgba(56,189,248,.12); }
        .field:disabled { opacity: .55; cursor: not-allowed; }
    </style>
</body>
</html>
